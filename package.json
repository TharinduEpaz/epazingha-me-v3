{
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": "> 0.5%, last 2 versions, Firefox ESR, not dead",
  "keywords": [
    "astro",
    "blog",
    "portfolio",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TharinduEpaz/epazingha-me-v3.git"
  },
  "bugs": {
    "url": "https://github.com/TharinduEpaz/epazingha-me-v3/issues"
  },
  "homepage": "https://www.epasingha.me",
  "name": "epasingha.me",
  "type": "module",
  "version": "2.0.0",
  "private": false,
  "scripts": {
    "dev": "astro dev --port 3010",
    "start": "astro dev --port 3010",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 astro check && NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write **/*.{ts,tsx,css,astro} --ignore-path .gitignore"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/markdown-satteri": "^0.3.3",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@expressive-code/plugin-collapsible-sections": "^0.44.0",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "@iconify-json/lucide": "^1.2.62",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "astro": "^7.0.6",
    "astro-expressive-code": "^0.44.0",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rehype-external-links": "^3.0.0",
    "remark-emoji": "^5.0.1",
    "satori": "^0.16.2",
    "satori-html": "^0.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "overrides": {
    "vite": "8.1.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
