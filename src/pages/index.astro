---
import Layout from '@/layouts/Layout.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { getRecentPosts, getAllProjects } from '@/lib/data-utils'
import { getInstagramPosts } from '@/lib/instagram'

const recentPosts = await getRecentPosts(4)
const projects = await getAllProjects()

// Live Instagram feed (build-time). Empty when no token / on error → the
// carousel falls back to the static status-feed below.
const igPosts = await getInstagramPosts(6)
const useIg = igPosts.length > 0
const igProfile = 'https://www.instagram.com/epazingha'

const now = new Date()
function projectStatus(endDate?: Date) {
  if (!endDate || endDate > now)
    return { label: 'ACTIVE', color: 'text-active', dot: 'bg-active' }
  return { label: 'COMPLETE', color: 'text-faint', dot: 'bg-faint' }
}

// Work history carousel (fallback when no live Instagram feed)
const experience = [
  {
    company: 'SYSCO LABS',
    role: 'SOFTWARE ENGINEER',
    period: 'APR 2026 — PRESENT',
    location: 'COLOMBO, SRI LANKA',
    logo: '/images/logos/sysco-labs.png',
  },
  {
    company: 'ITECHRO',
    role: 'SOFTWARE ENGINEER',
    period: 'APR 2024 — MAR 2026',
    location: 'COLOMBO, SRI LANKA',
    logo: '/images/logos/itechro.jpg',
  },
]
---

<Layout title="Home" bare>
  <div
    class="flex min-h-screen flex-col font-display text-body lg:flex-row"
  >
    <!-- ===================== LEFT COLUMN ===================== -->
    <section
      class="relative flex-1 border-b-2 border-line bg-panel px-6 py-14 sm:px-10 lg:border-b-0 lg:border-r-2"
    >
      <span class="bracket-tl !top-4 !left-4"></span>
      <span class="bracket-bl !bottom-4 !left-4"></span>

      <!-- tab plaque + theme switch -->
      <div class="mb-9 flex items-center justify-between gap-4">
      <div class="flex w-fit border-2 border-line" role="tablist">
        <button
          type="button"
          data-tab="about"
          class="tab-btn cursor-pointer px-6 py-2.5 font-display text-[13px] font-bold tracking-[2px]"
          aria-selected="true"
        >
          ABOUT
        </button>
        <button
          type="button"
          data-tab="blog"
          class="tab-btn cursor-pointer border-l-2 border-line px-6 py-2.5 font-display text-[13px] font-bold tracking-[2px]"
          aria-selected="false"
        >
          BLOG
        </button>
      </div>
        <ThemeToggle />
      </div>

      <!-- ABOUT panel -->
      <div data-panel="about">
        <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
          // PERSONNEL FILE
        </p>
        <h1
          class="mb-6 font-display text-[34px] font-bold tracking-wide text-ink"
        >
         THARINDU EPASINGHA 
        </h1>

        <div class="mb-6 flex items-start gap-6" data-reveal>
          <div
            class="relative h-[172px] w-[130px] flex-none overflow-hidden border border-line bg-card-alt"
          >
            <img
              src="/images/profile.png"
              alt="Tharindu Epasingha"
              width="130"
              height="172"
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover grayscale-[35%] contrast-[1.05] sepia-[10%]"
            />
            <span
              class="pointer-events-none absolute inset-0 shadow-[inset_0_0_0_1px_var(--color-accent)]"
            ></span>
            <span
              class="absolute left-1.5 top-1.5 h-2.5 w-2.5 border-l-[1.5px] border-t-[1.5px] border-accent"
            ></span>
            <span
              class="absolute bottom-1.5 right-1.5 h-2.5 w-2.5 border-b-[1.5px] border-r-[1.5px] border-accent"
            ></span>
          </div>
          <div class="pt-1.5">
            
            <p
              class="mt-2 font-mono text-[11.5px] leading-relaxed tracking-wide text-accent"
            >
              CALLSIGN: INDIE DEV<br />CLEARANCE: FULL-STACK
            </p>
          </div>
        </div>

        <p class="mb-4 text-base font-medium leading-relaxed text-ink">
          Six-year operational record in software engineering. Specializes in
          clean-code extractions, open-source support drops, and long-range
          architecture missions.
        </p>
        <p class="mb-4 text-base font-medium leading-relaxed text-ink">
          Off duty: bonsai maintenance, gym conditioning, and long-range recon
          on foot through the hills.
        </p>
        <p class="mb-7 text-base font-semibold leading-relaxed text-ink">
          BUILD SOFTWARE. GROW IMPACT. LIVE WITH PURPOSE.
        </p>

        <!-- carousel: live Instagram feed, or static status-feed fallback -->
        <div
          class="relative border border-line bg-card p-6"
          data-reveal
          style="--reveal-delay:120ms"
        >
          <span class="bracket-tl !-top-px !-left-px"></span>
          <span class="bracket-br !-bottom-px !-right-px"></span>

          {
            useIg ? (
              <div data-ig>
                <div class="mb-3 flex items-center justify-between">
                  <span class="flex items-center gap-2 font-mono text-[11px] tracking-[2px] text-active">
                    <span class="h-2 w-2 rounded-full bg-active shadow-[0_0_6px_currentColor]" />
                    LIVE FEED
                  </span>
                  <a
                    href={igProfile}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[10px] tracking-widest text-faint hover:text-accent"
                  >
                    @epazingha
                  </a>
                </div>

                <div class="flex items-center gap-4">
                  <button
                    type="button"
                    data-ig-prev
                    aria-label="Previous post"
                    class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center border-2 border-line bg-bg text-base text-accent transition-colors hover:border-accent"
                  >
                    &#9666;
                  </button>

                  <div class="relative h-56 flex-1 overflow-hidden border border-line bg-bg">
                    {igPosts.map((p, i) => (
                      <a
                        href={p.permalink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ig-slide absolute inset-0 block"
                        data-i={i}
                        data-caption={p.caption}
                        hidden={i !== 0}
                      >
                        <img
                          src={p.image}
                          alt={p.caption || 'Instagram post'}
                          loading="lazy"
                          class="h-full w-full object-cover"
                        />
                        <span class="pointer-events-none absolute inset-0 shadow-[inset_0_0_0_1px_var(--color-accent)]" />
                      </a>
                    ))}
                  </div>

                  <button
                    type="button"
                    data-ig-next
                    aria-label="Next post"
                    class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center border-2 border-line bg-bg text-base text-accent transition-colors hover:border-accent"
                  >
                    &#9656;
                  </button>
                </div>

                <div class="mt-3 flex items-center justify-between gap-3">
                  <p
                    class="line-clamp-1 flex-1 font-mono text-[11px] leading-relaxed text-muted"
                    data-ig-caption
                  >
                    {igPosts[0].caption}
                  </p>
                  <span class="flex-none font-mono text-[11px] tracking-[1px] text-faint">
                    POST <span data-ig-idx>01</span> /{' '}
                    {String(igPosts.length).padStart(2, '0')}
                  </span>
                </div>
              </div>
            ) : (
              <div data-exp>
                <div class="mb-3 flex items-center justify-between">
                  <span class="font-mono text-[11px] tracking-[2px] text-faint">
                    // WORK HISTORY
                  </span>
                  <span class="font-mono text-[10px] tracking-widest text-faint" data-exp-location>
                    {experience[0].location}
                  </span>
                </div>

                <div class="flex items-center gap-4">
                  <button
                    type="button"
                    data-exp-prev
                    aria-label="Previous role"
                    class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center border-2 border-line bg-bg text-base text-accent transition-colors hover:border-accent"
                  >
                    &#9666;
                  </button>

                  <div class="flex h-32 flex-1 items-center gap-4 border border-line bg-bg px-5">
                    <div class="flex h-14 w-14 flex-none items-center justify-center overflow-hidden border border-line bg-card-alt">
                      <img
                        src={experience[0].logo}
                        alt={`${experience[0].company} logo`}
                        loading="lazy"
                        class="h-full w-full object-contain p-1.5"
                        data-exp-logo
                      />
                    </div>
                    <div class="min-w-0">
                      <div class="font-mono text-[11px] tracking-[2px] text-faint" data-exp-company>
                        {experience[0].company}
                      </div>
                      <div class="mt-1 truncate font-mono text-sm tracking-wide text-accent" data-exp-role>
                        {experience[0].role}
                      </div>
                      <div class="mt-1 font-mono text-[10.5px] tracking-[1px] text-faint" data-exp-period>
                        {experience[0].period}
                      </div>
                    </div>
                  </div>

                  <button
                    type="button"
                    data-exp-next
                    aria-label="Next role"
                    class="flex h-9 w-9 flex-none cursor-pointer items-center justify-center border-2 border-line bg-bg text-base text-accent transition-colors hover:border-accent"
                  >
                    &#9656;
                  </button>
                </div>

                <div class="mt-3 flex items-center justify-end">
                  <span class="font-mono text-[11px] tracking-[1px] text-faint">
                    ROLE <span data-exp-idx>01</span> / 0{experience.length}
                  </span>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- BLOG panel -->
      <div data-panel="blog" hidden>
        <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
          // FIELD REPORTS
        </p>
        <h1
          class="mb-4 font-display text-[34px] font-bold tracking-wide text-ink"
        >
          BLOG
        </h1>
        <p class="mb-2 text-base leading-relaxed">
          Dispatches from the field — short reports on building things that hold
          up under fire.
        </p>
        <p class="mb-7 font-mono text-xs tracking-wide text-faint">
          LATEST TRANSMISSIONS
        </p>

        {
          recentPosts.map((post, i) => (
            <a
              href={`/blog/${post.id}`}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
              class="ops-row group mb-6 block border-b border-line pb-5"
            >
              <div class="font-display text-lg font-bold tracking-wide text-ink transition-colors group-hover:text-accent">
                {post.data.title}
              </div>
              <div class="mt-2 text-[14.5px] leading-relaxed text-muted">
                {post.data.description}
              </div>
            </a>
          ))
        }

        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-display text-[13px] font-bold tracking-widest text-accent"
        >
          &#9656; VIEW ALL TRANSMISSIONS
        </a>
      </div>
    </section>

    <!-- ===================== RIGHT COLUMN ===================== -->
    <section
      class="relative bg-panel-alt px-6 py-14 sm:px-10 lg:flex-[1.05]"
    >
      <span class="bracket-tr !top-4 !right-4"></span>
      <span class="bracket-br !bottom-4 !right-4"></span>

      <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
        // OPERATIONS LOG
      </p>
      <h1 class="mb-4 font-display text-[34px] font-bold tracking-wide text-ink">
        PROJECTS
      </h1>
      <p class="mb-8 max-w-lg text-base font-medium leading-relaxed text-ink">
        Recent and highest-impact missions undertaken as a solo operator.
      </p>

      {
        projects.map((proj, i) => {
          const status = projectStatus(proj.data.endDate)
          return (
            <div
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="ops-card relative mb-6 border border-l-[3px] border-line border-l-accent bg-card px-6 py-6"
            >
              <span class="ops-corner ops-corner-tl" />
              <span class="ops-corner ops-corner-br" />
              <div class="mb-2.5 flex items-center gap-2.5">
                <span class={`h-2 w-2 rounded-full ${status.dot} shadow-[0_0_6px_currentColor] ${status.color}`} />
                <span class={`font-mono text-[10px] tracking-[1.5px] ${status.color}`}>
                  {status.label}
                </span>
              </div>
              <div class="mb-2.5 font-display text-xl font-bold tracking-wide text-ink">
                {proj.data.name}
              </div>
              <div class="mb-4 text-[14.5px] leading-relaxed text-muted">
                {proj.data.description}
              </div>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                <a
                  href={`/projects/${proj.id}`}
                  class="flex flex-none items-center gap-1.5 whitespace-nowrap font-display text-[13px] font-bold tracking-wide text-accent"
                >
                  &#9656; VIEW PROJECT
                </a>
                {proj.data.link && (
                  <a
                    href={proj.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex flex-none items-center gap-1.5 whitespace-nowrap font-display text-[13px] font-bold tracking-wide text-accent"
                  >
                    &#9656; SOURCE
                  </a>
                )}
              </div>
            </div>
          )
        })
      }

      <a
        href="/projects"
        class="mt-2 inline-flex items-center gap-2 font-display text-[13px] font-bold tracking-widest text-accent"
      >
        &#9656; VIEW FULL OPERATIONS LOG
      </a>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ experience }}>
  // --- tab switching (ABOUT / BLOG) ---
  const tabBtns = document.querySelectorAll('[data-tab]')
  const panels = document.querySelectorAll('[data-panel]')
  const active = 'bg-accent text-bg'
  const inactive = 'bg-card text-faint'

  function setTab(name) {
    tabBtns.forEach((btn) => {
      const on = btn.dataset.tab === name
      btn.setAttribute('aria-selected', on ? 'true' : 'false')
      btn.classList.remove('bg-accent', 'text-bg', 'bg-card', 'text-faint')
      btn.classList.add(...(on ? active : inactive).split(' '))
    })
    panels.forEach((p) => {
      p.hidden = p.dataset.panel !== name
    })
  }
  tabBtns.forEach((btn) => btn.addEventListener('click', () => setTab(btn.dataset.tab)))
  setTab('about')

  // --- Instagram image carousel (when a live feed is present) ---
  const igRoot = document.querySelector('[data-ig]')
  if (igRoot) {
    const slides = Array.from(igRoot.querySelectorAll('.ig-slide'))
    const idxEl = igRoot.querySelector('[data-ig-idx]')
    const capEl = igRoot.querySelector('[data-ig-caption]')
    let g = 0
    function renderIg() {
      slides.forEach((s, n) => {
        s.hidden = n !== g
      })
      if (idxEl) idxEl.textContent = String(g + 1).padStart(2, '0')
      if (capEl) capEl.textContent = slides[g].dataset.caption || ''
    }
    igRoot
      .querySelector('[data-ig-prev]')
      ?.addEventListener('click', () => {
        g = (g - 1 + slides.length) % slides.length
        renderIg()
      })
    igRoot
      .querySelector('[data-ig-next]')
      ?.addEventListener('click', () => {
        g = (g + 1) % slides.length
        renderIg()
      })
    renderIg()
  } else {
    // --- work history carousel (fallback) ---
    let e = 0
    const logoEl = document.querySelector('[data-exp-logo]')
    const companyEl = document.querySelector('[data-exp-company]')
    const roleEl = document.querySelector('[data-exp-role]')
    const periodEl = document.querySelector('[data-exp-period]')
    const locationEl = document.querySelector('[data-exp-location]')
    const idxEl = document.querySelector('[data-exp-idx]')
    function renderExp() {
      const job = experience[e]
      logoEl.src = job.logo
      logoEl.alt = `${job.company} logo`
      companyEl.textContent = job.company
      roleEl.textContent = job.role
      periodEl.textContent = job.period
      locationEl.textContent = job.location
      idxEl.textContent = String(e + 1).padStart(2, '0')
    }
    document
      .querySelector('[data-exp-prev]')
      ?.addEventListener('click', () => {
        e = (e - 1 + experience.length) % experience.length
        renderExp()
      })
    document
      .querySelector('[data-exp-next]')
      ?.addEventListener('click', () => {
        e = (e + 1) % experience.length
        renderExp()
      })
  }
</script>
