---
import { type CollectionEntry, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

type Props = { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const { Content } = await render(project)

const span = [project.data.startDate, project.data.endDate]
  .filter(Boolean)
  .map((d) => formatDate(d as Date))
  .join(' — ')
---

<Layout title={project.data.name} description={project.data.description}>
  <article class="relative">
    <a
      href="/projects"
      class="mb-6 inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-faint hover:text-accent"
    >
      &#9666; RETURN TO OPERATIONS LOG
    </a>

    <p class="mb-2 font-mono text-[11px] tracking-[2px] text-faint">
      // MISSION FILE{span && ` · ${span.toUpperCase()}`}
    </p>
    <h1
      class="mb-4 font-display text-3xl font-bold tracking-wide text-ink sm:text-4xl"
    >
      {project.data.name}
    </h1>
    <p class="mb-6 max-w-2xl text-lg leading-relaxed text-muted">
      {project.data.description}
    </p>

    <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        project.data.link && (
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 border border-accent px-4 py-2 font-display text-[13px] font-bold tracking-wide text-accent transition-colors hover:bg-accent hover:text-bg"
          >
            &#9656; SOURCE
          </a>
        )
      }
      {
        project.data.tags && (
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <span class="border border-line px-2.5 py-1 font-mono text-[11px] tracking-wide text-faint">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <div class="post-body border-t-2 border-line pt-8">
      <Content />
    </div>
  </article>
</Layout>
