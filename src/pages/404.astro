---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404 — Signal Lost">
  <div
    class="relative flex min-h-[50vh] flex-col items-center justify-center border border-line bg-card px-6 py-20 text-center"
    data-reveal
  >
    <span class="bracket-tl !top-4 !left-4"></span>
    <span class="bracket-br !bottom-4 !right-4"></span>

    <p class="font-mono text-[11px] tracking-[2px] text-faint">
      // TRANSMISSION FAILED
    </p>
    <h1 class="mt-3 font-display text-6xl font-bold tracking-widest text-accent">
      404
    </h1>
    <p class="mt-4 font-mono text-sm tracking-widest text-muted">SIGNAL LOST</p>
    <p class="mt-2 max-w-md text-base leading-relaxed text-muted">
      The coordinates you requested are outside the operational area.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 border border-accent px-5 py-2.5 font-display text-[13px] font-bold tracking-widest text-accent transition-colors hover:bg-accent hover:text-bg"
    >
      &#9666; RETURN TO BASE
    </a>
  </div>
</Layout>
