---
import Layout from '@/layouts/Layout.astro'
import { getSortedTags } from '@/lib/data-utils'

const tags = await getSortedTags()
---

<Layout
  title="Tags"
  description="Browse field reports by topic."
>
  <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
    // INDEX
  </p>
  <h1 class="mb-3 font-display text-4xl font-bold tracking-wide text-ink">
    TAGS
  </h1>
  <p class="mb-10 max-w-2xl text-base leading-relaxed text-muted">
    {tags.length} classification markers across all transmissions.
  </p>

  <ul class="flex flex-wrap gap-3">
    {
      tags.map(({ tag, count }, i) => (
        <li>
          <a
            href={`/tags/${tag}`}
            data-reveal
            style={`--reveal-delay:${Math.min(i, 18) * 40}ms`}
            class="ops-card flex items-center gap-2 border border-line bg-card px-4 py-2"
          >
            <span class="font-display text-sm font-bold tracking-wide text-ink">
              #{tag}
            </span>
            <span class="font-mono text-[11px] text-accent">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
