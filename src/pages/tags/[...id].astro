---
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

export async function getStaticPaths() {
  const tags = await getAllTags()
  return [...tags.keys()].map((tag) => ({
    params: { id: tag },
    props: { tag },
  }))
}

const { tag } = Astro.props as { tag: string }
const posts = await getPostsByTag(tag)
---

<Layout title={`#${tag}`} description={`Field reports tagged #${tag}.`}>
  <a
    href="/tags"
    class="mb-6 inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-faint hover:text-accent"
  >
    &#9666; ALL TAGS
  </a>

  <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
    // FILTER
  </p>
  <h1 class="mb-3 font-display text-4xl font-bold tracking-wide text-ink">
    #{tag}
  </h1>
  <p class="mb-10 font-mono text-sm tracking-wide text-muted">
    {posts.length} transmission{posts.length === 1 ? '' : 's'} matched.
  </p>

  <ul class="flex flex-col gap-4">
    {
      posts.map((post, i) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
            class="ops-card group block border border-l-[3px] border-line border-l-accent bg-card px-5 py-5"
          >
            <span class="ops-corner ops-corner-tl" />
            <span class="ops-corner ops-corner-br" />
            <div class="mb-1.5 font-mono text-[11px] tracking-widest text-faint">
              {formatDate(post.data.date).toUpperCase()}
            </div>
            <div class="font-display text-xl font-bold tracking-wide text-ink transition-colors group-hover:text-accent">
              {post.data.title}
            </div>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">
              {post.data.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
