---
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, groupPostsByYear } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

const posts = await getAllPosts()
const byYear = groupPostsByYear(posts)
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a))
---

<Layout
  title="Blog"
  description="Field reports on software engineering, cloud, and building things that hold up under fire."
>
  <div class="relative">
    <p class="mb-1.5 font-mono text-[11px] tracking-[2px] text-faint">
      // FIELD REPORTS
    </p>
    <h1 class="mb-3 font-display text-4xl font-bold tracking-wide text-ink">
      BLOG
    </h1>
    <p class="mb-10 max-w-2xl text-base leading-relaxed text-muted">
      Dispatches from the field — short reports on building things that hold up
      under fire. {posts.length} transmissions logged.
    </p>

    {
      years.map((year) => (
        <section class="mb-10">
          <div class="mb-5 flex items-center gap-4">
            <span class="font-mono text-sm font-bold tracking-widest text-accent">
              {year}
            </span>
            <span class="h-px flex-1 bg-line" />
          </div>

          <ul class="flex flex-col gap-4">
            {byYear[year].map((post, i) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  data-reveal
                  style={`--reveal-delay:${i * 70}ms`}
                  class="ops-card group relative block border border-l-[3px] border-line border-l-accent bg-card px-5 py-5"
                >
                  <span class="ops-corner ops-corner-tl" />
                  <span class="ops-corner ops-corner-br" />
                  <div class="mb-1.5 font-mono text-[11px] tracking-widest text-faint">
                    {formatDate(post.data.date).toUpperCase()}
                  </div>
                  <div class="font-display text-xl font-bold tracking-wide text-ink transition-colors group-hover:text-accent">
                    {post.data.title}
                  </div>
                  <p class="mt-2 text-[15px] leading-relaxed text-muted">
                    {post.data.description}
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wide text-faint">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
