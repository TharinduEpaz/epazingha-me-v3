---
import { type CollectionEntry, render } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, getAdjacentPosts } from '@/lib/data-utils'
import { formatDate, readingTime } from '@/lib/utils'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

type Props = { post: CollectionEntry<'blog'> }
const { post } = Astro.props
const { Content } = await render(post)
const { prev, next } = await getAdjacentPosts(post.id)
const mins = readingTime(post.body ?? '')
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={`/image/${post.id}.png`}
  type="article"
>
  <article class="relative">
    <a
      href="/blog"
      class="mb-6 inline-flex items-center gap-2 font-mono text-[11px] tracking-widest text-faint hover:text-accent"
    >
      &#9666; RETURN TO FIELD REPORTS
    </a>

    <p class="mb-2 font-mono text-[11px] tracking-[2px] text-faint">
      // TRANSMISSION · {formatDate(post.data.date).toUpperCase()} · {mins.toUpperCase()}
    </p>
    <h1
      class="mb-4 font-display text-3xl font-bold leading-tight tracking-wide text-ink sm:text-4xl"
    >
      {post.data.title}
    </h1>
    <p class="mb-6 max-w-2xl text-lg leading-relaxed text-muted">
      {post.data.description}
    </p>

    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="border border-line px-2.5 py-1 font-mono text-[11px] tracking-wide text-faint transition-colors hover:border-accent hover:text-accent"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      post.data.image && (
        <div class="relative mb-10 border border-line">
          <span class="bracket-tl" />
          <span class="bracket-br" />
          <Image
            src={post.data.image}
            alt={post.data.title}
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 768px"
            class="w-full"
            loading="eager"
          />
        </div>
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <!-- prev / next -->
    <nav
      class="mt-14 grid gap-4 border-t-2 border-line pt-8 sm:grid-cols-2"
      aria-label="Adjacent transmissions"
    >
      {
        prev ? (
          <a
            href={`/blog/${prev.id}`}
            class="group border border-line bg-card px-5 py-4 transition-colors hover:border-accent"
          >
            <span class="font-mono text-[10px] tracking-widest text-faint">
              &#9666; PREVIOUS
            </span>
            <span class="mt-1 block font-display font-bold tracking-wide text-ink group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/blog/${next.id}`}
            class="group border border-line bg-card px-5 py-4 text-right transition-colors hover:border-accent sm:col-start-2"
          >
            <span class="font-mono text-[10px] tracking-widest text-faint">
              NEXT &#9656;
            </span>
            <span class="mt-1 block font-display font-bold tracking-wide text-ink group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</Layout>
