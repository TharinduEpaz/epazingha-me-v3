---
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  title="Toggle light / dark"
  class:list={[
    'flex h-9 w-9 flex-none items-center justify-center border-2 border-line bg-card text-faint transition-colors hover:border-accent hover:text-accent',
    className,
  ]}
>
  <Icon name="lucide:sun" class="theme-sun h-4 w-4" />
  <Icon name="lucide:moon" class="theme-moon h-4 w-4" />
</button>
